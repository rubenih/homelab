# --- IMMICH CONFIGURATION ---
# Versión a desplegar (release = última estable)
IMMICH_VERSION=v3

# --- BASE DE DATOS (Postgres) ---
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
# Puedes cambiar esta contraseña si quieres, pero anótala
# DB_PASSWORD gestionado mediante Docker secret

# --- RUTAS DE ALMACENAMIENTO ---
# 1. LAS FOTOS: Apuntan a tu montaje de TrueNAS
UPLOAD_LOCATION=/mnt/immich

# 2. LA BASE DE DATOS: Apunta a tu disco local de Ubuntu
DB_DATA_LOCATION=/opt/docker-volumes/data/postgres_immich

# --- VARIOS ---
TZ=Europe/Madrid
REDIS_HOSTNAME=immich_redis
DB_HOSTNAME=immich_postgres
MACHINE_LEARNING_URL=http://immich-machine-learning:3003
